{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: Main.py (debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/Main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "env": {
                "FLASK_DEBUG": "False"
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
